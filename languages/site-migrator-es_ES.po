#: includes/class-site-migrator-admin.php:253
msgid "Images are uploaded to the Media Library without creating or changing any page. Images already in the library are not duplicated."
msgstr "Las imágenes se suben a la biblioteca de medios sin crear ni modificar ninguna página. Las que ya estén en la biblioteca no se duplican."

